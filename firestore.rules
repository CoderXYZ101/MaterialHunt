rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // the moment a new Pro period starts: now, or when current Pro ends if that is later
    function prizeBase(userData) {
      return userData.get('pro_until', request.time) > request.time ? userData.pro_until : request.time;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles. Users create their own profile as a plain free member and may edit
    // harmless fields only. tier / role / kyb_status can only be changed by an admin
    // (for example after a payment is confirmed) from the Firebase console or admin tooling.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.tier == 'free'
        && request.resource.data.role == 'member'
        && request.resource.data.kyb_status == 'pending'
        && !('promo_code' in request.resource.data)
        && !('pro_until' in request.resource.data);
      // a member may only edit harmless profile fields; plan, role, verification, promo and award fields are locked
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'org', 'org_id']);
      // activating a redeemed promo code: one time, and only for the code on this user's own redemption record
      allow update: if signedIn() && request.auth.uid == uid
        && !('promo_code' in resource.data)
        && exists(/databases/$(database)/documents/redemptions/$(uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['promo_code', 'promo_at', 'promo_days'])
        && request.resource.data.promo_code == get(/databases/$(database)/documents/redemptions/$(uid)).data.code
        && request.resource.data.promo_at == request.time
        && request.resource.data.promo_days == get(/databases/$(database)/documents/promos/$(request.resource.data.promo_code)).data.days;
      // claiming a prize: adds the prize's Pro days (within a day of tolerance for clock differences),
      // and only in the same batch that marks that prize as claimed
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pro_until', 'award_note'])
        && request.resource.data.award_note is string
        && get(/databases/$(database)/documents/prizes/$(request.resource.data.award_note)).data.user_id == uid
        && get(/databases/$(database)/documents/prizes/$(request.resource.data.award_note)).data.claimed == false
        && getAfter(/databases/$(database)/documents/prizes/$(request.resource.data.award_note)).data.claimed == true
        && request.resource.data.pro_until <= prizeBase(resource.data) + duration.value(get(/databases/$(database)/documents/prizes/$(request.resource.data.award_note)).data.days + 1, 'd')
        && request.resource.data.pro_until >= prizeBase(resource.data) + duration.value(get(/databases/$(database)/documents/prizes/$(request.resource.data.award_note)).data.days - 1, 'd');
      allow update: if isAdmin();
      // a member can delete their own account record (the website also removes the rest of their data)
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Prizes are written by the automatic prize job (a bot admin account). A winner can only read their own
    // prizes and mark one as claimed (together with the Pro days, see the users rule above).
    match /prizes/{prizeId} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      // only places 1, 2 and 3 can ever exist: one prize per place per leaderboard (id = leaderboard + "_" + place)
      allow create: if isAdmin()
        && request.resource.data.rank in [1, 2, 3]
        && ((request.resource.data.rank == 1 && prizeId.matches('^.+_1$'))
          || (request.resource.data.rank == 2 && prizeId.matches('^.+_2$'))
          || (request.resource.data.rank == 3 && prizeId.matches('^.+_3$')));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.user_id == request.auth.uid && !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
      allow update: if signedIn() && resource.data.user_id == request.auth.uid
        && resource.data.claimed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimed_at'])
        && request.resource.data.claimed == true
        && request.resource.data.claimed_at == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.award_note == prizeId;
    }

    // Promo codes live only here (created by an admin). Clients can never read or list them.
    match /promos/{code} {
      allow list, create, delete: if isAdmin();
      allow get: if isAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/redemptions/$(request.auth.uid))
          && get(/databases/$(database)/documents/redemptions/$(request.auth.uid)).data.code == code);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.active == true
          && resource.data.uses < resource.data.max_uses
          && existsAfter(/databases/$(database)/documents/redemptions/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/redemptions/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/redemptions/$(request.auth.uid)).data.code == code
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
          && request.resource.data.uses == resource.data.uses + 1);
    }

    // One redemption per account, and only for a code that exists, is active and has uses left.
    match /redemptions/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['code', 'created_at'])
        && request.resource.data.code is string
        && request.resource.data.created_at == request.time
        && exists(/databases/$(database)/documents/promos/$(request.resource.data.code))
        && get(/databases/$(database)/documents/promos/$(request.resource.data.code)).data.active == true
        && get(/databases/$(database)/documents/promos/$(request.resource.data.code)).data.uses < get(/databases/$(database)/documents/promos/$(request.resource.data.code)).data.max_uses;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Public profile. Readable by signed-in members only (photos are never public).
    // Members can add or change their own photo; admins review photos by hand every day (Admin -> Photos),
    // can remove a photo, reset a name or bio, and block photos for a member who misuses them.
    function profileFieldsOk() {
      return request.resource.data.keys().hasOnly(['display_name', 'bio', 'org', 'who', 'avatar', 'show_avatar', 'updated_at', 'name_lower', 'discoverable'])
        && request.resource.data.display_name is string && request.resource.data.display_name.size() > 0 && request.resource.data.display_name.size() <= 40
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 200
        && request.resource.data.org is string && request.resource.data.org.size() <= 80
        && request.resource.data.who in ['', 'Student', 'Engineer or professional', 'Business owner or buyer', 'Educator', 'Researcher', 'Maker or hobbyist']
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 30000
        && request.resource.data.show_avatar is bool
        && request.resource.data.name_lower is string && request.resource.data.name_lower == request.resource.data.display_name.lower()
        && request.resource.data.discoverable is bool
        && request.resource.data.updated_at == request.time;
    }

    // Set by an admin when a member's photos are switched off. It lives apart from the profile so it survives profile deletion.
    function photoBlocked() {
      return exists(/databases/$(database)/documents/photo_blocks/$(request.auth.uid));
    }

    match /photo_blocks/{memberId} {
      allow get: if signedIn() && request.auth.uid == memberId;
      allow read, write: if isAdmin();
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && profileFieldsOk()
        && (request.resource.data.avatar == '' || !photoBlocked());
      allow update: if signedIn() && request.auth.uid == uid
        && profileFieldsOk()
        && (request.resource.data.avatar == '' || request.resource.data.avatar == resource.data.get('avatar', '') || !photoBlocked());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar', 'show_avatar', 'photo_blocked', 'display_name', 'bio', 'org', 'who', 'updated_at']);
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Reports about a profile (photo, name, bio or behaviour). One report per reporter per member.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['reporter', 'target', 'reason', 'note', 'status', 'created_at'])
        && request.resource.data.reporter == request.auth.uid
        && reportId == request.auth.uid + '_' + request.resource.data.target
        && request.resource.data.target is string && request.resource.data.target != request.auth.uid
        && request.resource.data.reason in ['photo', 'name_or_bio', 'harassment', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.status == 'new'
        && request.resource.data.created_at == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handled_at']);
      allow delete: if false;
    }

    // One public, non-personal record per account. Only used to count sign-ups.
    match /signups/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['created_at', 'verified', 'provider', 'referred_by'])
        && request.resource.data.created_at == request.time
        && request.resource.data.verified == (request.auth.token.email_verified == true);
      // verified may only flip false -> true, and only once the email is verified
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.verified == false
        && request.resource.data.verified == true
        && request.auth.token.email_verified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified']);
      allow delete: if signedIn() && request.auth.uid == uid && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Public counters shown on the landing page. Increments are only allowed together with the
    // matching signup write (batched), so numbers cannot be bumped arbitrarily.
    match /stats/public {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['total_users', 'verified_users'])
        && request.resource.data.total_users == 1
        && request.resource.data.verified_users in [0, 1]
        && !exists(/databases/$(database)/documents/signups/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/signups/$(request.auth.uid));

      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['total_users', 'verified_users'])
        && (
          // a brand new sign-up
          (
            !exists(/databases/$(database)/documents/signups/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/signups/$(request.auth.uid))
            && request.resource.data.total_users == resource.data.total_users + 1
            && (
              (getAfter(/databases/$(database)/documents/signups/$(request.auth.uid)).data.verified == true
                && request.resource.data.verified_users == resource.data.verified_users + 1)
              ||
              (getAfter(/databases/$(database)/documents/signups/$(request.auth.uid)).data.verified == false
                && request.resource.data.verified_users == resource.data.verified_users)
            )
          )
          ||
          // an existing account completing email verification
          (
            exists(/databases/$(database)/documents/signups/$(request.auth.uid))
            && get(/databases/$(database)/documents/signups/$(request.auth.uid)).data.verified == false
            && getAfter(/databases/$(database)/documents/signups/$(request.auth.uid)).data.verified == true
            && request.auth.token.email_verified == true
            && request.resource.data.total_users == resource.data.total_users
            && request.resource.data.verified_users == resource.data.verified_users + 1
          )
        );
      // an admin can recalculate the numbers (for example after excluding test accounts)
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['total_users', 'verified_users'])
        && request.resource.data.total_users is int && request.resource.data.total_users >= 0
        && request.resource.data.verified_users is int && request.resource.data.verified_users >= 0
        && request.resource.data.verified_users <= request.resource.data.total_users;
      allow delete: if false;
    }

    // Leads (RFQs, lab tests, upgrade requests, waitlist). Anyone may submit a well-formed lead;
    // only the submitter or an admin can read it back. Immutable once created.
    match /rfq_leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['kind', 'name', 'organization', 'email', 'created_at'])
        && request.resource.data.kind in ['rfq', 'lab_test', 'upgrade', 'waitlist', 'demo', 'payment', 'kyb']
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.organization is string && request.resource.data.organization.size() <= 160
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 160
        && request.resource.data.created_at == request.time
        && request.resource.data.keys().size() <= 24
        && (!('user_id' in request.resource.data)
            || request.resource.data.user_id == ''
            || (signedIn() && request.resource.data.user_id == request.auth.uid));
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      // admins can mark a request handled / approved / rejected (nothing else can change)
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'handled_at', 'handled_by', 'admin_note'])
        && (!('admin_note' in request.resource.data) || (request.resource.data.admin_note is string && request.resource.data.admin_note.size() <= 300));
      allow delete: if signedIn() && resource.data.get('user_id', '') == request.auth.uid;
    }

    // Feedback.
    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['rating', 'comment', 'created_at', 'user_id'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 1500
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.created_at == request.time;
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'triaged_at']);
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // Discovery registry entries: signed-in users can submit, signed-in users can read.
    match /leaderboard/{entryId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['user_id', 'formula', 'predicted_mpa', 'score', 'dataset', 'created_at'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.created_at == request.time;
      allow read: if signedIn();
      allow update, delete: if false;
    }

    // Saved designs: private to the owner. Rename-only updates; owner can delete.
    match /designs/{designId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.keys().hasOnly(['user_id', 'name', 'composition', 'conditions', 'result', 'grade', 'created_at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.composition is map
        && request.resource.data.conditions is map
        && request.resource.data.result is map
        && request.resource.data.grade is string && request.resource.data.grade.size() <= 80
        && request.resource.data.created_at == request.time;
      allow update: if signedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // Public benchmark leaderboard. One entry per user per period (document id = period + "_" + uid).
    // A new design overwrites the previous entry for that period.
    match /challenge_entries/{entryId} {
      allow read: if true;
      allow create, update: if signedIn()
        && entryId == request.resource.data.period + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'formula', 'composition', 'medal', 'sf', 'cost', 'density', 'score', 'user_id', 'created_at', 'period', 'bench'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.period.matches('^[0-9]{4}-(W[0-9]{2}|M[0-9]{2})$')
        && request.resource.data.bench is string && request.resource.data.bench.size() <= 30
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.formula is string && request.resource.data.formula.size() <= 60
        && request.resource.data.composition is map
        && request.resource.data.medal in ['GOLD', 'SILVER', 'BRONZE']
        && request.resource.data.sf is number && request.resource.data.cost is number && request.resource.data.density is number
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 600
        && request.resource.data.created_at == request.time;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // Daily limit on live AI questions. The assistant's server (Cloudflare Worker) counts each question here
    // using the member's own login, so this rule is what enforces the limit. Limits come from settings/ai
    // (editable by an admin, so they can be tightened on a busy day without redeploying).
    function aiCap() {
      let cfg = exists(/databases/$(database)/documents/settings/ai) ? get(/databases/$(database)/documents/settings/ai).data : {};
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let pro = (u.get('tier', 'free') != 'free' && u.get('plan_until', request.time) >= request.time)
        || u.get('pro_until', request.time) > request.time
        || (u.get('promo_at', null) != null && request.time < u.promo_at + duration.value(u.get('promo_days', 0), 'd'));
      return pro ? cfg.get('pro', 60) : cfg.get('free', 15);
    }

    match /ai_usage/{usageId} {
      allow read: if signedIn() && usageId.matches('^' + request.auth.uid + '_[0-9]{8}$');
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && usageId.matches('^' + request.auth.uid + '_[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'count'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == 1;
      allow update: if signedIn()
        && request.auth.token.email_verified == true
        && usageId.matches('^' + request.auth.uid + '_[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'count'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= aiCap();
      // daily counters can only be removed once the account record is gone (so the limit cannot be reset)
      allow delete: if signedIn() && usageId.matches('^' + request.auth.uid + '_[0-9]{8}$') && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Site-wide settings (for example the daily AI limits). Anyone can read; only an admin can change.
    match /settings/{name} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community challenges: any verified member can propose one; an admin must approve it before it is public.
    // The creator may offer Pro days to the top 3; they only count once an admin marks the challenge funded
    // (MaterialHunt never moves money between members).
    match /community_challenges/{cid} {
      allow read: if resource.data.status in ['live', 'closed']
        || (signedIn() && resource.data.owner == request.auth.uid)
        || isAdmin();
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['owner', 'owner_name', 'title', 'brief', 'temp', 'burst', 'load', 'max_density', 'max_cost', 'min_sf', 'banned', 'metals_only', 'environment', 'prize_days', 'funded', 'status', 'ref_formula', 'ref_sf', 'created_at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.funded == false
        && request.resource.data.owner_name is string && request.resource.data.owner_name.size() <= 40
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 50
        && request.resource.data.brief is string && request.resource.data.brief.size() >= 10 && request.resource.data.brief.size() <= 240
        && request.resource.data.temp is number && request.resource.data.temp >= -273 && request.resource.data.temp <= 4500
        && request.resource.data.burst is number && request.resource.data.burst >= 0 && request.resource.data.burst <= 5000
        && request.resource.data.load is number && request.resource.data.load >= 0 && request.resource.data.load <= 5000
        && request.resource.data.max_density is number && request.resource.data.max_density > 0 && request.resource.data.max_density <= 25
        && request.resource.data.max_cost is number && request.resource.data.max_cost > 0 && request.resource.data.max_cost <= 100000
        && request.resource.data.min_sf is number && request.resource.data.min_sf >= 1 && request.resource.data.min_sf <= 5
        && request.resource.data.banned is string && request.resource.data.banned.size() <= 40
        && request.resource.data.metals_only is bool
        && request.resource.data.environment is string && request.resource.data.environment.size() <= 40
        && request.resource.data.prize_days in [0, 3, 7, 14]
        && request.resource.data.ref_formula is string && request.resource.data.ref_formula.size() <= 60
        && request.resource.data.ref_sf is number
        && request.resource.data.created_at == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ends_at', 'funded', 'admin_note']);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.owner == request.auth.uid);
    }

    // One entry per member per community challenge; a new design overwrites the old one.
    match /community_entries/{entryId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.token.email_verified == true
        && entryId == request.resource.data.challenge + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['challenge', 'user_id', 'name', 'formula', 'composition', 'sf', 'cost', 'density', 'score', 'created_at'])
        && request.resource.data.user_id == request.auth.uid
        && exists(/databases/$(database)/documents/community_challenges/$(request.resource.data.challenge))
        && get(/databases/$(database)/documents/community_challenges/$(request.resource.data.challenge)).data.status == 'live'
        && get(/databases/$(database)/documents/community_challenges/$(request.resource.data.challenge)).data.ends_at > request.time
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.formula is string && request.resource.data.formula.size() <= 60
        && request.resource.data.composition is map
        && request.resource.data.sf is number && request.resource.data.cost is number && request.resource.data.density is number
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 600
        && request.resource.data.created_at == request.time;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // Endorsements: short notes from real members. Public only after an admin approves them. One per member.
    match /endorsements/{memberId} {
      allow read: if resource.data.status == 'approved' || (signedIn() && request.auth.uid == memberId) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == memberId
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['user_id', 'name', 'role', 'org', 'relation', 'rating', 'quote', 'status', 'verified', 'created_at'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.verified == false
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.role is string && request.resource.data.role.size() > 0 && request.resource.data.role.size() <= 80
        && request.resource.data.org is string && request.resource.data.org.size() <= 80
        && request.resource.data.relation in ['none', 'friend', 'family', 'mentor']
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.quote is string && request.resource.data.quote.size() >= 20 && request.resource.data.quote.size() <= 400
        && request.resource.data.created_at == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verified', 'admin_note']);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == memberId);
    }

    // Record of prizes handed out (admin only).
    match /awards/{awardId} {
      allow read, write: if isAdmin();
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
