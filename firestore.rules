rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles - users can read/write their own profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Admins can read all users
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // RFQ leads - users can create their own leads, admins can read all
    match /rfq_leads/{leadId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['kind', 'name', 'organization', 'email', 'created_at'])
        && request.resource.data.name is string
        && request.resource.data.organization is string
        && request.resource.data.email is string
        && request.resource.data.kind in ['rfq', 'lab_test']
        && request.resource.data.created_at == request.time;
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.user_id
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow update, delete: if false; // Immutable once created
    }

    // Feedback - users can create their own, admins can read all and update status
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['rating', 'comment', 'created_at'])
        && request.resource.data.rating in [1, 2, 3, 4, 5]
        && request.resource.data.comment is string
        && request.resource.data.created_at == request.time;
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.user_id
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && request.resource.data.keys().hasOnly(['status', 'triaged_at'])
        && request.resource.data.triaged_at == request.time;
      allow delete: if false;
    }

    // Leaderboard entries - authenticated users can submit, everyone can read top 100
    match /leaderboard/{entryId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['user_id', 'formula', 'predicted_mpa', 'score', 'dataset', 'created_at'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.created_at == request.time;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Admin-only collections
    match /admin/{document=**} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}